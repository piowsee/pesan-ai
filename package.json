    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "next": "16.2.11",
    "next-intl": "^4.12.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.1",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-icons": "^5.6.0",
